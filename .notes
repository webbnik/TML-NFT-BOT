-- Export floor history to CSV, e.g. for graphs:
-- docker exec tml-nft-bot python -c "import sqlite3, csv, sys; c = sqlite3.connect('instance/nft.db'); w = csv.writer(sys.stdout); w.writerow(['symbol', 'recorded_utc', 'floor_lamports', 'listed']); w.writerows(c.execute('SELECT symbol, recorded, floor, listed FROM floor_history ORDER BY recorded'))" > floor_history.csv
